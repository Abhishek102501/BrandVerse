# Toggle between the mock service layer and a real Spring Boot backend.
# When you build the backend, set VITE_USE_MOCK=false and point VITE_API_BASE_URL
# at your API. No UI or hook code needs to change.
VITE_APP_NAME=BrandVerse
VITE_API_BASE_URL=/api
VITE_USE_MOCK=true
VITE_GROQ_API_KEY=your_groq_api_key_here